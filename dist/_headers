/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'

/brik.min.js
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/brik-theme.min.css
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=0, must-revalidate

/v1/*
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400, must-revalidate

/examples/*
  ! X-Frame-Options
  X-Frame-Options: SAMEORIGIN
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'self'
